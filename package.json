{
  "name": "clickbait",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:domain",
    "typecheck:domain": "tsc --noEmit --project tsconfig.check.json",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:e2e:run": "playwright test",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "check:all": "npm run check && npm run test:e2e:run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@fontsource/saira-condensed": "^5.2.8",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.11",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10",
      "sharp": "0.35.3"
    }
  }
}
